import os, sqlite3, logging
from decimal import Decimal
from datetime import datetime
from telegram import ReplyKeyboardMarkup, KeyboardButton, Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes, MessageHandler, filters

BOT_TOKEN = os.environ.get("BOT_TOKEN") or ""
DATABASE_PATH = "debt.db"
logging.basicConfig(level=logging.INFO)

def fmt(a: Decimal): return f"{a:.0f}" if a == int(a) else f"{a:.2f}"

def init_db():
    with sqlite3.connect(DATABASE_PATH) as c:
        c.execute("CREATE TABLE IF NOT EXISTS debt_entries (id INTEGER PRIMARY KEY, user_id INTEGER, debtor_name TEXT, amount TEXT, created_at TEXT, due_date TEXT)")
        c.commit()
init_db()

def book(uid):
    with sqlite3.connect(DATABASE_PATH) as c:
        rows=c.execute("SELECT debtor_name,amount,created_at,due_date FROM debt_entries WHERE user_id=? ORDER BY id DESC",(uid,)).fetchall()
    totals,last,due={}, {}, {}
    for n,a,ca,dd in rows:
        k=n.casefold()
        if k not in totals: totals[k]=[n,Decimal("0")]; last[k]=ca or ""; due[k]=dd or ""
        totals[k][1]+=Decimal(a)
        if ca and ca>last[k]: last[k]=ca; due[k]=dd or ""
    bal=sorted([(nm,tt) for nm,tt in totals.values() if tt>0], key=lambda x:x[1], reverse=True)
    total=sum((x[1] for x in bal),Decimal("0"))
    lines=["📒 Дафтари карз (аз калонтарин):"]
    for i,(nm,am) in enumerate(bal,1):
        d=last.get(nm.casefold(),"")[:10]; dd=due.get(nm.casefold(),"")
        lines.append(f"{i}. {nm} — {fmt(am)} сомонӣ — {d}"+(f" ⏰ то {dd}" if dd else ""))
    if not bal: lines.append("Ҳоло қарз нест.")
    lines+=["",f"💰 Ҷамъ: {fmt(total)} сомонӣ",f"👥 {len(bal)} нафар"]
    return lines

def hist(uid,q):
    with sqlite3.connect(DATABASE_PATH) as c:
        rows=c.execute("SELECT debtor_name,amount,created_at,due_date FROM debt_entries WHERE user_id=? AND debtor_name LIKE? ORDER BY id DESC",(uid,f"%{q}%")).fetchall()
    if not rows: return [f"🔍 {q} ёфт нашуд."]
    tot=Decimal("0"); lines=[f"📜 Тарих: {rows[0][0]}:"]
    for _,a,ca,dd in rows:
        am=Decimal(a); tot+=am; lines.append(f"{ca[:16]} {'+' if am>0 else ''}{fmt(am)}"+(f" (то {dd})" if dd else ""))
    lines.append(f"\n💰 Ҷамъ: {fmt(tot)} сомонӣ"); return lines

async def start(update, context):
    await update.message.reply_text("Салом! 👋\nАли 1000 - қарз\nАли -500 - баргардонд\nАли 1000 то 2026-10-15 - бо мӯҳлат\n/qarz - ҳама\n/qarz Али - тарих\n/toza Али - тоза", reply_markup=ReplyKeyboardMarkup([[KeyboardButton("/qarz")]],resize_keyboard=True))

async def qarz(update, context):
    lines=hist(update.effective_user.id," ".join(context.args)) if context.args else book(update.effective_user.id)
    await update.message.reply_text("\n".join(lines))

async def toza(update, context):
    if not context.args: await update.message.reply_text("Нависед: /toza Али"); return
    name=" ".join(context.args)
    with sqlite3.connect(DATABASE_PATH) as c:
        cur=c.execute("DELETE FROM debt_entries WHERE user_id=? AND debtor_name LIKE?",(update.effective_user.id,f"%{name}%")); c.commit()
    await update.message.reply_text(f"✅ {name} тоза шуд ({cur.rowcount})" if cur.rowcount else "❌ Ёфт нашуд.")

async def txt(update, context):
    t=update.message.text.strip(); due=""
    if " то " in t: t,due=t.split(" то ",1); due=due.strip()[:10]
    try:
        name,am_s=t.rsplit(maxsplit=1); am=Decimal(am_s.replace(",","."))
        with sqlite3.connect(DATABASE_PATH) as c:
            c.execute("INSERT INTO debt_entries (user_id,debtor_name,amount,created_at,due_date) VALUES (?,?,?,?,?)",(update.effective_user.id,name.strip(),str(am),datetime.now().isoformat(),due)); c.commit()
        await update.message.reply_text(f"✅ Сабт: {name} {fmt(am)}"+(f" то {due}" if due else ""))
    except: await update.message.reply_text("Намуна: Али 1000 ё Али 1000 то 2026-10-15")

def main():
    ApplicationBuilder().token(BOT_TOKEN).build().add_handler(CommandHandler("start",start)).add_handler(CommandHandler("qarz",qarz)).add_handler(CommandHandler("toza",toza)).add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,txt)).run_polling()
    # упростил для Render

if __name__=="__main__":
    app=ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start",start)); app.add_handler(CommandHandler("qarz",qarz)); app.add_handler(CommandHandler("toza",toza))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,txt))
    app.run_polling()
